# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
DerivedData/
build/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated by XcodeGen from ios/MiddleGround/App/project.yml — regenerate, don't commit.
# Info.plist is generated too: edit project.yml, not that file.
#
# The entitlements files are NOT generated and ARE committed. XcodeGen writes one
# entitlements file per target at the base build-setting level, which overrode the
# per-configuration CODE_SIGN_ENTITLEMENTS and signed Release with the *development* APNs
# entitlement. Both files are now hand-maintained; project.yml only selects between them.
*.xcodeproj/
ios/MiddleGround/App/Info.plist
TestResults.xcresult/

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved IS committed: dependencies use open version ranges, so pinning it
# is what makes builds reproducible across machines and CI.

# CocoaPods / Carthage
Pods/
Carthage/Build/

# Firebase — never commit real app config or service accounts
GoogleService-Info.plist
google-services.json
serviceAccountKey.json
.firebase/
firebase-debug.log

# Node (CloudFunctions)
node_modules/
npm-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example

# Editor / tooling
.vscode/
.idea/
.claude/settings.local.json

# Firebase Hosting staging directory. Generated by the `predeploy` hook in
# ios/MiddleGround/firebase.json, which copies docs/legal/*.html here because Hosting
# refuses a public directory outside the project root. docs/legal is the source.
ios/MiddleGround/public/

# Firebase emulator debris (rules tests write these next to firebase.json)
firestore-debug.log
firebase-debug.log
ui-debug.log
