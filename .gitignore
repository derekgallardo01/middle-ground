# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
DerivedData/
build/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated by XcodeGen from ios/MiddleGround/App/project.yml — regenerate, don't commit.
# Info.plist and the entitlements are generated too: edit project.yml, not those files.
*.xcodeproj/
ios/MiddleGround/App/Info.plist
ios/MiddleGround/App/MiddleGround.entitlements
TestResults.xcresult/

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved IS committed: dependencies use open version ranges, so pinning it
# is what makes builds reproducible across machines and CI.

# CocoaPods / Carthage
Pods/
Carthage/Build/

# Firebase — never commit real app config or service accounts
GoogleService-Info.plist
google-services.json
serviceAccountKey.json
.firebase/
firebase-debug.log

# Node (CloudFunctions)
node_modules/
npm-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example

# Editor / tooling
.vscode/
.idea/
.claude/settings.local.json
