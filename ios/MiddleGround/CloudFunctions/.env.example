# Operator alert configuration for Cloud Functions.
#
# Copy to `.env` (gitignored) before deploying. Firebase reads .env at deploy time and bakes
# these into the function environment.
#
# The Resend API key is NOT here — it is a secret, set once with:
#     firebase functions:secrets:set RESEND_API_KEY
# and bound per-function via defineSecret in index.js.

# Where every operator alert is delivered. Leave unset and alerts are skipped with a log line
# rather than failing — that is the intended state for the emulator.
OPERATOR_EMAIL=you@example.com

# Must be on a domain verified in Resend or every send is rejected.
#
# NOTE: middleground.app publishes `v=spf1 -all` at the root, which forbids all mail from the
# bare domain. Use a subdomain with its own SPF/DKIM (e.g. send.middleground.app), or Resend's
# shared sender, which only delivers to the Resend account owner's own address — fine for
# operator alerts, useless for anything user-facing.
ALERT_FROM=onboarding@resend.dev
